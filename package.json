{
  "name": "playwright-kavia",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright baseline test suite scaffold (Kavia).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "report": "sh -c 'echo "Playwright HTML report server: 0.0.0.0:9324"; echo "In this Kavia environment, do NOT use http://localhost:9324 (it points to the container)."; echo "Open the forwarded report URL via /proxy/9324/ instead:"; echo "  <your-session-base-url>/proxy/9324/"; npx playwright show-report --host 0.0.0.0 --port 9324 --no-open playwright-report'",
    "report:local": "playwright show-report --host localhost --port 9324 playwright-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0"
  }
}
