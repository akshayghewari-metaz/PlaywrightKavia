# PlaywrightKavia environment variables (example)
#
# Copy to .env in your own environment if needed.
# Do NOT commit real secrets in .env.

# In this environment, Playwright is often configured to look for browsers under /ms-playwright.
# If PLAYWRIGHT_BROWSERS_PATH is set to /ms-playwright but browsers are not installed there,
# Playwright will fail with:
#   "Executable doesn't exist at /ms-playwright/..."
#
# Setting this ensures `npm run install:browsers` installs into /ms-playwright.
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
